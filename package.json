{
  "name": "tsdown-porffor",
  "type": "module",
  "version": "0.0.0",
  "packageManager": "pnpm@11.26.0",
  "description": "",
  "author": "Kevin Deng <sxzz@sxzz.moe>",
  "license": "MIT",
  "funding": "https://github.com/sponsors/sxzz",
  "homepage": "https://github.com/sxzz/tsdown-porffor#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sxzz/tsdown-porffor.git"
  },
  "bugs": {
    "url": "https://github.com/sxzz/tsdown-porffor/issues"
  },
  "exports": {
    ".": "./dist/index.js",
    "./package.json": "./package.json"
  },
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=20.19.0"
  },
  "scripts": {
    "lint": "eslint --cache .",
    "lint:fix": "pnpm run lint --fix",
    "build": "tsdown",
    "dev": "tsdown --watch",
    "test": "vitest",
    "typecheck": "tsgo --noEmit",
    "format": "prettier --cache --write .",
    "release": "bumpp",
    "prepublishOnly": "pnpm run build"
  },
  "devDependencies": {
    "@sxzz/eslint-config": "^8.0.0",
    "@sxzz/prettier-config": "^2.3.1",
    "@types/node": "^25.5.0",
    "@typescript/native-preview": "7.0.0-dev.20260707.2",
    "bumpp": "^12.0.0",
    "eslint": "^10.0.3",
    "porffor": "^0.61.12",
    "prettier": "^3.8.1",
    "tinyexec": "^1.0.4",
    "tsdown": "^0.23.0",
    "tsdown-preset-sxzz": "^0.7.0",
    "typescript": "^6.0.0",
    "vitest": "^4.1.0"
  },
  "prettier": "@sxzz/prettier-config"
